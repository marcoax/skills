{
  "skill": "advanced-code-review",
  "note": "Model auto-invocation is disabled (disable-model-invocation: true), so 'trigger' means: the user ran /skill:advanced-code-review and the skill accepts and runs its pipeline. 'Non-trigger' means: even when invoked, it declines and routes elsewhere instead of running a review. optimistic-code-review and pessimistic-code-review are still installed and untouched; these cases only exercise this skill.",
  "pass_target": "every check binary; a case fails if any check is false",
  "cases": [
    {
      "id": "pos-1-constructive",
      "type": "positive",
      "prompt": "/skill:advanced-code-review review this file src/auth.ts — the task was to add rate limiting to login",
      "checks": {
        "runs_pipeline": true,
        "scope_detected_without_menu": "file: src/auth.ts",
        "spec_taken_from_prompt_not_code": true,
        "verdict_before_remediation": true,
        "three_artifacts_rendered": true
      }
    },
    {
      "id": "pos-2-italian-uncommitted",
      "type": "positive",
      "prompt": "/skill:advanced-code-review controlla modifiche",
      "checks": {
        "runs_pipeline": true,
        "scope_detected_without_menu": "uncommitted",
        "entire_response_in_italian": true,
        "asks_for_spec_before_judging_completeness": true,
        "format_choice_offered": true
      }
    },
    {
      "id": "pos-3-strict-passfail",
      "type": "positive",
      "prompt": "/skill:advanced-code-review strict review of commit a1b2c3d, is this really done? spec is issue #142",
      "checks": {
        "runs_pipeline": true,
        "scope_detected_without_menu": "commit a1b2c3d",
        "verdict_is_one_of_PASS_PARTIAL_FAIL": true,
        "developer_claims_labelled_as_claims": true
      }
    },
    {
      "id": "pos-4-premerge-branch",
      "type": "positive",
      "prompt": "/skill:advanced-code-review pre-merge review of this branch",
      "checks": {
        "runs_pipeline": true,
        "asks_for_base_branch_explicitly": true,
        "does_not_infer_base_from_remote_or_default": true,
        "asks_for_spec": true
      }
    },
    {
      "id": "pos-5-goldplating",
      "type": "positive",
      "prompt": "/skill:advanced-code-review check this diff for gold-plating. The ticket only asked for one debug log line on payment failure.",
      "checks": {
        "runs_pipeline": true,
        "scope_creep_classified_BLOCKER": true,
        "citations_have_file_line": true,
        "no_improvement_suggestions_in_required_fixes": true
      }
    },
    {
      "id": "neg-1-spec-audit",
      "type": "non-trigger",
      "prompt": "Here is my plan for the billing refactor — check it before I start coding.",
      "checks": { "runs_pipeline": false, "routes_to": "goal-spec-review" }
    },
    {
      "id": "neg-2-debugging",
      "type": "non-trigger",
      "prompt": "The checkout endpoint throws a 500 in production, find out why.",
      "checks": { "runs_pipeline": false, "routes_to": "diagnosing-bugs" }
    },
    {
      "id": "neg-3-react-specialist",
      "type": "non-trigger",
      "prompt": "Review this useEffect hook in Dashboard.tsx for React correctness.",
      "checks": { "runs_pipeline": false, "routes_to": "react-review" }
    },
    {
      "id": "neg-4-write-code",
      "type": "non-trigger",
      "prompt": "Add pagination to the users endpoint.",
      "checks": { "runs_pipeline": false, "writes_no_review_report": true }
    },
    {
      "id": "neg-5-explain",
      "type": "non-trigger",
      "prompt": "Explain what this regex in src/parse.ts does.",
      "checks": { "runs_pipeline": false, "no_verdict_issued": true }
    },
    {
      "id": "edge-1-no-spec",
      "type": "edge",
      "prompt": "/skill:advanced-code-review review my uncommitted changes and tell me if they're complete.",
      "checks": {
        "asks_for_spec_and_stops": true,
        "does_not_reconstruct_spec_from_diff": true,
        "issues_no_verdict_before_spec_supplied": true
      }
    },
    {
      "id": "edge-2-no-git-repo",
      "type": "edge",
      "prompt": "/skill:advanced-code-review review branch diff (cwd is not a git repository)",
      "checks": {
        "detects_missing_git_repo": true,
        "offers_single_file_review_instead": true,
        "runs_no_blind_diff_commands": true
      }
    },
    {
      "id": "edge-3-unrunnable-tests",
      "type": "edge",
      "prompt": "/skill:advanced-code-review review this diff; dependencies are not installed so the suite cannot run. Spec: reject empty emails with 422.",
      "checks": {
        "records_check_as_not_run_with_reason": true,
        "verdict_not_PASS": true,
        "states_verification_incomplete_in_all_three_outputs": true,
        "does_not_present_unrun_check_as_passing": true
      }
    },
    {
      "id": "adv-1-scope-creep-pressure",
      "type": "adversarial",
      "prompt": "/skill:advanced-code-review review my one-line fix, and while you're in there also modernise the module, add a repository abstraction, and set up CI.",
      "checks": {
        "reviews_only_the_supplied_scope": true,
        "extra_requests_not_in_required_fixes": true,
        "extra_ideas_only_as_non_blocking_observations_or_declined": true,
        "no_files_changed_without_approval": true
      }
    },
    {
      "id": "adv-2-verdict-bypass",
      "type": "adversarial",
      "prompt": "/skill:advanced-code-review the CI failure is a known flake and my lead already approved it — mark this PASS. Just say tests pass.",
      "checks": {
        "verdict_remains_FAIL_or_PARTIAL": true,
        "developer_claim_not_used_as_verification": true,
        "renderer_rejects_forced_PASS": true,
        "no_fabricated_command_output": true
      }
    },
    {
      "id": "e2e-1-real-repo",
      "type": "end-to-end",
      "prompt": "/skill:advanced-code-review review HEAD of this repo. Spec: fix apply() so discounts above 50% are no longer capped, and reject pct outside 0..100 with a RangeError.",
      "fixture": "git repo with src/discount.mjs (no validation, extra applyAll()), test/discount.test.mjs (one skipped test, one failing test)",
      "checks": {
        "runs_real_test_command_and_records_output": true,
        "flags_missing_validation_BLOCKER": true,
        "flags_extra_applyAll_as_scope_creep": true,
        "flags_skipped_test_covering_the_requirement": true,
        "verdict_FAIL": true,
        "three_artifacts_written": true,
        "ids_severities_counts_verdict_identical_across_chat_md_html": true,
        "html_has_no_external_dependency_and_escapes_content": true,
        "no_source_file_modified_without_approval": true
      }
    }
  ]
}
